          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "prestamos"
          ]
        },
        "description": "El material 1 debe estar activo y tener disponibilidad.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"material_id\": 1,\n  \"responsable\": \"Juan Pérez\",\n  \"cantidad\": 2,\n  \"fecha_prevista_devolucion\": \"2026-10-20\",\n  \"observaciones\": \"Práctica de química analítica.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
