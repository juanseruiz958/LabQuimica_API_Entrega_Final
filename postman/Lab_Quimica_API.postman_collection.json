          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "materiales",
            "1"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Bureta 50 ml actualizada\",\n  \"categoria\": \"VIDRIERIA\",\n  \"descripcion\": \"Bureta graduada para titulaciones.\",\n  \"cantidad_total\": 6,\n  \"estado\": \"ACTIVO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Desactivar material",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/materiales/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "materiales",
            "1"
          ]
        },
        "description": "Desactiva sin borrar historial."
      },
      "response": []
    },
