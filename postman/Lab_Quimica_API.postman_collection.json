    {
      "name": "Crear material",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/materiales",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "materiales"
          ]
        },
        "description": "Crear material de prueba.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Bureta 50 ml\",\n  \"categoria\": \"VIDRIERIA\",\n  \"descripcion\": \"Bureta graduada para titulaciones.\",\n  \"cantidad_total\": 6,\n  \"estado\": \"ACTIVO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creado',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Actualizar material",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
