          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/materiales?q=vaso",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "materiales?q=vaso"
          ]
