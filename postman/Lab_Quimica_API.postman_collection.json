{
  "info": {
    "name": "Lab Química API - Pruebas",
    "description": "Colección de pruebas manuales para los endpoints de Lab Química.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"CORREO_DE_CUENTA_REGISTRADA\",\n  \"contrasena\": \"CONTRASENA_DE_LA_CUENTA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Usa las credenciales de una cuenta creada previamente desde la app o el endpoint de registro."
      },
      "response": []
    },
    {
      "name": "Registrar laboratorista",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laboratorista de prueba\",\n  \"correo\": \"lab.{{$randomInt}}@example.edu\",\n  \"contrasena\": \"Cambiar1234\",\n  \"rol\": \"LABORATORISTA\",\n  \"codigoLaboratorista\": \"REEMPLAZAR_POR_CODIGO_LOCAL\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Requiere el código configurado por el administrador en LABORATORISTA_REGISTRATION_CODE."
      },
      "response": []
    },
    {
      "name": "Registrar estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario de prueba\",\n  \"correo\": \"nuevo.{{$randomInt}}@example.edu\",\n  \"contrasena\": \"Cambiar1234\",\n  \"rol\": \"ESTUDIANTE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "El registro devuelve token y usuario; cambia los datos si repites la solicitud."
      },
      "response": []
    },
    {
      "name": "Health - API y MySQL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Debe responder estado OK y base de datos conectada."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar materiales",
      "request": {
        "method": "GET",
