            "exec": [
              "pm.test('Creado',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Prueba negativa: cantidad excesiva",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/prestamos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "prestamos"
          ]
        },
        "description": "Debe responder 409 por falta de disponibilidad.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"material_id\": 1,\n  \"responsable\": \"Prueba\",\n  \"cantidad\": 99999,\n  \"fecha_prevista_devolucion\": \"2026-10-20\"\n}",
          "options": {
